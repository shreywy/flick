{
  "name": "flick",
  "version": "0.1.0",
  "description": "Watch the movies and shows in E:Media",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node24 --outdir=dist-electron --external:electron --log-level=warning",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "dist": "npm run build && electron-builder --dir"
  },
  "type": "commonjs",
  "dependencies": {
    "@ctrl/video-filename-parser": "^5.11.4",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "fflate": "^0.8.3",
    "jassub": "^2.5.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "productName": "Flick",
  "private": true,
  "build": {
    "appId": "local.shrey.flick",
    "productName": "Flick",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "npmRebuild": false
  },
  "author": "Shrey"
}
